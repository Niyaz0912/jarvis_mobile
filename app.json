{
  "expo": {
    "name": "jarvis mobile",
    "slug": "jarvis_mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/jarvis.png",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/jarvis.png",
        "backgroundColor": "#0A0B1A"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.hasanov_niyaz.jarvis_mobile"
    },
    "web": {
      "favicon": "./assets/jarvis.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b3331f01-35ba-4619-96b9-93362333d9e8"
      }
    }
  }
}
